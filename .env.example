# Backend Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Configuration (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=retailmart
POSTGRES_PASSWORD=retailmart_secure_pw
POSTGRES_DB=retailmart_dw
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# DuckDB Configuration
DUCKDB_PATH=./data_warehouse/retailmart.duckdb

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Chroma RAG
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_ANONYMIZED_TELEMETRY=false

# Memory Configuration
CONVERSATION_HISTORY_RETENTION_DAYS=90
REPORT_RETENTION_DAYS=365

# API Configuration
API_TITLE=DecisionLens AI
API_VERSION=1.0.0
API_DESCRIPTION=Enterprise Decision Intelligence Platform

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Feature Flags
ENABLE_POWER_BI_EMBED=false
ENABLE_RAG=true
ENABLE_FORECASTING=true
ENABLE_ANOMALY_DETECTION=true

# Email Configuration (optional, for report delivery)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
REPORT_DELIVERY_EMAIL=
